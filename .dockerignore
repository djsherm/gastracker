# Keep secrets, data, and clutter out of the Docker image.
# Secrets are passed at runtime via env_file / environment, never baked in.
.env
.env.*
!.env.example
.git/
.gitignore
*.csv
data/
backups/
uploads/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
tests/
docs/
README.md
.idea/
.vscode/
