# ---------------------------------------------------------------
# Gas Spending Tracker: SECRET configuration template.
#
# Copy this file to ".env" and fill in real values:
#     cp .env.example .env
#
# .env is gitignored and dockerignored. NEVER commit it, paste it
# into an issue, or share it. If a real value ever leaks, rotate it
# (generate a new token and update the iPhone shortcut).
# ---------------------------------------------------------------

# Shared secret the iPhone shortcut sends in the X-Ingest-Token
# header. Generate a long random value with:
#     python3 -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_TOKEN=replace-with-generated-token

# Optional extra layer: an unguessable path segment so the ingest
# route becomes /ingest/<this value>. Leave empty to use plain /ingest.
# Generate with the same command as above.
INGEST_PATH_SECRET=

# Public base address of the ingest service (your Tailscale Funnel
# hostname). The app uses it to show the URL to paste into the
# shortcut. Keep the real hostname out of the repo.
PUBLIC_BASE_URL=https://<machine>.<tailnet>.ts.net

# ---------------------------------------------------------------
# Docker Compose host-side ports (not secret, but they differ per
# server because ports like 8080 are often already taken).
# Funnel must point at INGEST_HOST_PORT only, never at WEB_HOST_PORT.
# ---------------------------------------------------------------
WEB_HOST_PORT=8000
INGEST_HOST_PORT=8765

# Timezone for the container
TZ=America/Toronto
